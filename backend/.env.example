# Dhan credentials are server-side secrets.
# Local development: place values only in backend/.env.
# Production: configure these as secret environment variables in Render.
# Never expose either value through VITE_* variables.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Local HTTP API used by VITE_API_BASE_URL=http://127.0.0.1:8000.
# Keep these checked-in defaults loopback-safe. Render's start command supplies
# --host 0.0.0.0 and --port $PORT explicitly at runtime.
TECO_SERVER_HOST=127.0.0.1
TECO_SERVER_PORT=8000
# Exact comma-separated browser origins only. Wildcards and URL paths are rejected.
TECO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TECO_API_MAX_BODY_BYTES=16384

# Independent databases are required because each subsystem owns a separate schema.
TECO_DATABASE_PATH=data/teco_quant.db
TECO_EXECUTION_DATABASE_PATH=data/teco_execution.db
TECO_SIGNAL_HISTORY_DATABASE_PATH=data/teco_signals.db
TECO_LOG_LEVEL=INFO
TECO_LIVE_MAX_AGE_SECONDS=30

# DATA_ONLY is the safe default. PAPER_TRADING is the only other accepted value.
# LIVE_AUTOMATIC is rejected by the runtime and no Dhan order gateway is installed.
TECO_EXECUTION_MODE=DATA_ONLY

# Read-only Dhan REST/WebSocket automation. With blank credentials the backend still
# starts and reports CONFIG_REQUIRED. Contracts/subscriptions are discovered daily.
TECO_DHAN_LIVE_ENABLED=false
# Optional legacy seed list; normal operation discovers current IDs automatically.
TECO_DHAN_INSTRUMENTS=
TECO_FEED_IDLE_TIMEOUT_SECONDS=30
TECO_FEED_RECONNECT_MAX_SECONDS=60

# Optional operator-owned decision profile. Leave the whole group blank for fail-closed
# analytics/NO TRADE. If used, every required field through TECO_OPERATING_MODE must be
# supplied together. Fractions use 0.01 = 1%; no financial values are guessed.
TECO_ACCOUNT_CAPITAL=
TECO_RISK_PER_TRADE=
TECO_MAX_PREMIUM_ALLOCATION=
TECO_EVENT_RISK_ACTIVE=
TECO_EXPECTED_HOLDING_HOURS=
TECO_TRADING_STYLE=
TECO_OPERATING_MODE=
# Optional manual confirmation: true, false, or blank.
TECO_PRICE_ACTION_CONFIRMED=

# Optional server-side mutation key for paper/manual controls. The frontend must never
# receive this value. Leave blank to keep all POST controls disabled.
TECO_API_KEY=
