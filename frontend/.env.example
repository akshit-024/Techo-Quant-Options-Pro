# Browser-visible backend URL only.
# Local:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production:
# Set VITE_API_BASE_URL in Render to the HTTPS URL of the deployed backend.
# Rebuild/redeploy the static site after changing it; Vite injects this value
# into the browser bundle at build time.
#
# Never place Dhan credentials, tokens, passwords, or private API keys
# in any VITE_* variable because Vite bundles them into the browser.
